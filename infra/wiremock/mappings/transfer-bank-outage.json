{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/transfers",
    "headers": { "Idempotency-Key": { "matches": "payment-[0-9]+" } },
    "bodyPatterns": [ { "matchesJsonPath": "$[?(@.destinationAccount == '9999999999')]" } ]
  },
  "response": {
    "status": 503,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": "SERVICE_UNAVAILABLE" }
  }
}
