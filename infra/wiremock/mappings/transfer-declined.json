{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/transfers",
    "headers": { "Idempotency-Key": { "matches": "payment-[0-9]+" } },
    "bodyPatterns": [ { "matchesJsonPath": "$[?(@.destinationAccount == '0000000000')]" } ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "DECLINED", "reason": "ACCOUNT_CLOSED" }
  }
}
