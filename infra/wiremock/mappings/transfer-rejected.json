{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/transfers",
    "headers": { "Idempotency-Key": { "matches": "payment-[0-9]+" } },
    "bodyPatterns": [ { "matchesJsonPath": "$[?(@.destinationAccount == '4000000000')]" } ]
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": "INVALID_REQUEST" }
  }
}
